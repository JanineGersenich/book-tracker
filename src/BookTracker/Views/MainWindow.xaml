<Window x:Class="BookTracker.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:BookTracker.Converters"
        xmlns:models="clr-namespace:BookTracker.Models"
        Title="BookTracker" Height="700" Width="1050" MinHeight="500" MinWidth="800">

    <Window.Resources>
        <conv:RatingToStarsConverter x:Key="RatingToStars" />
        <conv:StatusToGermanConverter x:Key="StatusToGerman" />

        <ObjectDataProvider x:Key="StatusValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}"
                             xmlns:sys="clr-namespace:System;assembly=mscorlib">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:ReadingStatus" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <TabControl Margin="12">
        <!-- ================= TAB 1: BIBLIOTHEK ================= -->
        <TabItem Header="Bibliothek">
            <DockPanel Margin="8">

                <!-- Filterleiste -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Margin="0,0,8,0" VerticalContentAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Suche nach Titel oder Autor..." />

                    <ComboBox Grid.Column="1" Margin="0,0,8,0"
                              ItemsSource="{Binding AvailableGenres}"
                              SelectedItem="{Binding SelectedGenreFilter}"
                              IsEditable="False" />

                    <ComboBox Grid.Column="2" Margin="0,0,8,0"
                              ItemsSource="{Binding Source={StaticResource StatusValues}}"
                              SelectedItem="{Binding SelectedStatusFilter}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource StatusToGerman}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Grid.Column="3" Content="+ Neues Buch" Click="AddBook_Click" />
                </Grid>

                <!-- Bücherliste -->
                <DataGrid ItemsSource="{Binding Books}"
                          SelectedItem="{Binding SelectedBook}"
                          MouseDoubleClick="BooksGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Titel" Binding="{Binding Title}" Width="2*" />
                        <DataGridTextColumn Header="Autor" Binding="{Binding Author.Name}" Width="1.3*" />
                        <DataGridTextColumn Header="Genre" Binding="{Binding Genre}" Width="*" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status, Converter={StaticResource StatusToGerman}}" Width="120" />
                        <DataGridTextColumn Header="Bewertung" Binding="{Binding Rating, Converter={StaticResource RatingToStars}}" Width="110" />
                        <DataGridTextColumn Header="Seiten" Binding="{Binding PageCount}" Width="70" />
                        <DataGridTextColumn Header="Fertig am" Binding="{Binding DateFinished, StringFormat=dd.MM.yyyy}" Width="100" />
                        <DataGridTemplateColumn Header="" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Löschen" Style="{StaticResource SecondaryButton}"
                                            Padding="8,3" Click="DeleteBook_Click" Tag="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <!-- ================= TAB 2: ANALYSEN ================= -->
        <TabItem Header="Analysen" GotFocus="AnalyticsTab_GotFocus">
            <ScrollViewer Margin="8" VerticalScrollBarVisibility="Auto"
                          DataContext="{Binding Analytics}">
                <StackPanel>

                    <!-- Kennzahlen -->
                    <UniformGrid Columns="3" Margin="0,0,0,20">
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="16" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Gelesene Bücher" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Text="{Binding TotalBooksFinished}" FontSize="26" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="16" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="Ø Bewertung" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Text="{Binding AverageRating}" FontSize="26" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="16" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Gelesene Seiten" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Text="{Binding TotalPagesRead}" FontSize="26" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Genre-Verteilung -->
                    <TextBlock Text="Bücher nach Genre" FontWeight="Bold" FontSize="15" Margin="0,0,0,8" />
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="14" Margin="0,0,0,20">
                        <ItemsControl ItemsSource="{Binding GenreStats}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="30" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Background="{StaticResource AccentBrush}" Height="16"
                                                Width="{Binding BarWidth}" HorizontalAlignment="Left" CornerRadius="3" />
                                        <TextBlock Grid.Column="2" Text="{Binding Value}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- Top Autoren -->
                    <TextBlock Text="Meistgelesene Autor:innen" FontWeight="Bold" FontSize="15" Margin="0,0,0,8" />
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="14" Margin="0,0,0,20">
                        <ItemsControl ItemsSource="{Binding TopAuthors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="30" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Background="{StaticResource AccentLightBrush}" Height="16"
                                                Width="{Binding BarWidth}" HorizontalAlignment="Left" CornerRadius="3" />
                                        <TextBlock Grid.Column="2" Text="{Binding Value}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- Bücher pro Jahr -->
                    <TextBlock Text="Gelesene Bücher pro Jahr" FontWeight="Bold" FontSize="15" Margin="0,0,0,8" />
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                        <ItemsControl ItemsSource="{Binding BooksPerYear}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="30" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Background="{StaticResource AccentBrush}" Height="16"
                                                Width="{Binding BarWidth}" HorizontalAlignment="Left" CornerRadius="3" />
                                        <TextBlock Grid.Column="2" Text="{Binding Value}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
